# Copy to .env.local and fill in. NEVER commit real values.

# --- Supabase (required for live mode; omit all three to run demo mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — production deploy environment only, never client-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI review (optional; without a key the deterministic fallback engine runs) ---
# Requires a BAA with the provider before any real beneficiary data is sent.
ANTHROPIC_API_KEY=
# Model override; defaults to the current supported model in code.
# AI_REVIEW_MODEL=claude-sonnet-5
# Per-organization daily AI review budget (default 100).
# AI_REVIEW_DAILY_LIMIT=100

# --- Local demo only. MUST be unset in every non-local environment. ---
# DEMO_BYPASS_AUTH=true

# --- Environment label: development | test | production | demo ---
APP_ENV=development
